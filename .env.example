POSTGRES_DB=matty_stack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matty_stack
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=dev-secret-change-me-32-characters
BETTER_AUTH_URL=http://localhost:5173

# Keep browser traffic same-origin. Set these only for split-origin deployments.
VITE_API_URL=
VITE_WS_URL=

# Server-only upstreams used by Vite in development and deployed previews.
API_PROXY_TARGET=http://localhost:3000
WS_PROXY_TARGET=http://localhost:3000

# Optional
# CORS_ORIGINS=http://localhost:5173
# WEB_ALLOWED_HOSTS=example.com
# LOG_LEVEL=info
